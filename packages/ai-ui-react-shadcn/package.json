{
  "name": "@nube/ai-ui-react-shadcn",
  "version": "0.1.0",
  "description": "shadcn/ui variant of @nube/ai-ui-react. Component library renders via the consumer's shadcn primitives (peer dep).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components.json": "./dist/components.json"
  },
  "files": [
    "src",
    "dist/components.json"
  ],
  "scripts": {
    "generate:components": "tsx scripts/generate-components-json.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@radix-ui/react-slot": "*",
    "lucide-react": "*",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "dependencies": {
    "@openuidev/react-headless": "latest",
    "@openuidev/react-ui": "latest",
    "@openuidev/react-lang": "latest",
    "@nube/ai-ui-react": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
