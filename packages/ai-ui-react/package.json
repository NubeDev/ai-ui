{
  "name": "@nube/ai-ui-react",
  "version": "0.1.0",
  "description": "Thin wrapper around @openuidev/react-ui pre-wired to the ai-ui Rust server. Stock OpenUI component library.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
